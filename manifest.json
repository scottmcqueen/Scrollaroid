{
  "manifest_version": 3,
  "name": "Scrollaroid",
  "version": "1.3.0",
  "description": "Snap a whole scrolling page in one go, then crop it and black out anything private.",
  "permissions": [
    "activeTab",
    "scripting",
    "unlimitedStorage",
    "clipboardWrite",
    "contextMenus",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Capture full page (Alt+Shift+S) · right-click for more",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Capture the full page (or stop a capture)"
    },
    "capture-area": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Capture a selected area"
    },
    "capture-evidence": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Capture the full page as evidence"
    }
  }
}
